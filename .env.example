# GEMINI_API_KEY: Required for server-side Gemini AI features (Smart Space Calculator, AI Inventory Assistant).
GEMINI_API_KEY=

# APP_URL: Hosted URL of the STOVRA application.
APP_URL=

# MONGODB_URI: Optional MongoDB connection string for production MongoDB deployment (SQLite persists automatically when unset).
MONGODB_URI=

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay test/live credentials (Test Mode verification runs automatically when unset).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# GOOGLE_CLIENT_ID: Optional Google OAuth Client ID for Google Sign-In.
GOOGLE_CLIENT_ID=

# SMS_PROVIDER_API_KEY: Optional SMS gateway API key for OTP delivery (Sandbox preview mode activates when unset).
SMS_PROVIDER_API_KEY=
